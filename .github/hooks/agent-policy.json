{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "windows": "pwsh -NoProfile -File .github/scripts/agent-policy.ps1",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "windows": "pwsh -NoProfile -File .github/scripts/post-tool-check.ps1",
        "timeout": 15
      }
    ]
  }
}
